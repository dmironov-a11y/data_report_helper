# GitHub
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_ORG=your-org-login
GITHUB_USERNAME=your-github-login
GITHUB_EXTRA_REPOS=other-org/specific-repo  # optional, comma-separated
GITHUB_PR_REPO=Org/repo-name                # repo for PR links, e.g. Paynext-com/paynext-tinybird

# Slack (optional, needed for --slack flag)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_ID=U0123456789

# Notion (optional, filters snapshot to your assigned tasks only)
NOTION_USER_ID=user://your-notion-user-uuid
